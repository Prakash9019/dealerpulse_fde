# Server-side only — never exposed to the client bundle. Copy this file to
# .env.local and fill in your own key. Without GEMINI_API_KEY set, Ask
# DealerPulse falls back to the deterministic rule-based Q&A engine and the
# rest of the dashboard is unaffected.
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash if unset. Change here, not in code.
GEMINI_MODEL=
